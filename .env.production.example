# Copiar a .env.production en el server y ajustar secretos antes de docker compose up

# MySQL
MYSQL_ROOT_PASSWORD=change-me-root-password
DB_HOST=mysql
DB_PORT=3306
DB_USER=velocesport
DB_PASSWORD=change-me-db-password
DB_NAME=velocesport

# Super admin inicial (solo en primer deploy: RUN_PRODUCTION_SEED=true)
SUPER_ADMIN_PASSWORD=change-me-super-admin-password

# Backend
NODE_ENV=production
PORT=3000
JWT_ACCESS_SECRET=change-me-access-secret-min-32-characters-long
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-characters-long
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
SESSION_INACTIVITY_TIMEOUT=60m
CORS_ORIGINS=https://aby.litomalone.dev
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=2000
AUTH_LOGIN_RATE_LIMIT_WINDOW_MS=900000
AUTH_LOGIN_RATE_LIMIT_MAX=10

# Web (JWT_ACCESS_SECRET debe coincidir con backend)
PUBLIC_API_URL=https://aby.litomalone.dev/profe
PUBLIC_SITE_URL=https://aby.litomalone.dev
INTERNAL_API_URL=http://backend:3000
ASTRO_BASE=/profe
# Orígenes públicos para CSRF de Astro (checkOrigin). Incluir el Host que ve el browser.
ASTRO_SITE=https://aby.litomalone.dev
ASTRO_ALLOWED_ORIGINS=https://aby.litomalone.dev

# MinIO (fotos de jugadores) — volumen persistente minio_data, como mysql_data
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change-me-minio-password
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=change-me-minio-password
MINIO_BUCKET=squadveloce-players
MINIO_USE_SSL=false
MINIO_PUBLIC_ENDPOINT=127.0.0.1
MINIO_PUBLIC_PORT=9100

# Primer deploy: true. Luego volver a false.
RUN_PRODUCTION_SEED=true
