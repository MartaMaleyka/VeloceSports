FROM node:20-alpine AS build
RUN corepack enable && corepack prepare pnpm@9.15.0 --activate
WORKDIR /app

COPY pnpm-lock.yaml pnpm-workspace.yaml package.json tsconfig.base.json ./
COPY packages/shared ./packages/shared
COPY apps/backend ./apps/backend

RUN pnpm install --frozen-lockfile --ignore-scripts
RUN pnpm --filter @velocesport/shared build \
 && pnpm --filter @velocesport/backend build

# Solo dependencias de producción (sin tsx, jest, typescript...) + paquetes del workspace.
RUN pnpm --filter @velocesport/backend deploy --prod /out \
 && cp -r apps/backend/dist /out/dist \
 && cp -r apps/backend/db /out/db

FROM node:20-alpine AS runtime
WORKDIR /app/apps/backend

ENV NODE_ENV=production

COPY --from=build --chown=node:node /out ./
COPY --chown=node:node docker/backend-entrypoint.sh /entrypoint.sh
RUN sed -i 's/\r$//' /entrypoint.sh && chmod +x /entrypoint.sh

USER node
EXPOSE 3000
ENTRYPOINT ["/entrypoint.sh"]
