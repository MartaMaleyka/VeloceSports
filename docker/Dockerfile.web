FROM node:20-alpine AS build
RUN corepack enable && corepack prepare pnpm@9.15.0 --activate
WORKDIR /app

# Solo valores públicos de build (Astro los necesita para `site`, `base` y CSRF).
# Los secretos (JWT_ACCESS_SECRET) se inyectan en runtime: nunca en capas de la imagen.
ARG ASTRO_BASE=/
ARG ASTRO_SITE
ARG ASTRO_ALLOWED_ORIGINS
ARG PUBLIC_SITE_URL

ENV ASTRO_BASE=${ASTRO_BASE}
ENV ASTRO_SITE=${ASTRO_SITE}
ENV ASTRO_ALLOWED_ORIGINS=${ASTRO_ALLOWED_ORIGINS}
ENV PUBLIC_SITE_URL=${PUBLIC_SITE_URL}
ENV CI=true

COPY pnpm-lock.yaml pnpm-workspace.yaml package.json tsconfig.base.json ./
COPY packages ./packages
COPY apps/web ./apps/web

RUN pnpm install --frozen-lockfile --ignore-scripts
RUN pnpm --filter @velocesport/shared build \
 && pnpm --filter @velocesport/i18n build \
 && pnpm --filter @velocesport/design-system build
RUN pnpm --filter @velocesport/web build

# Dependencias SSR de producción (react, jsonwebtoken...) sin toolchain de build.
RUN pnpm --filter @velocesport/web deploy --prod /out \
 && rm -rf /out/dist && cp -r apps/web/dist /out/dist

FROM node:20-alpine AS runtime
# Astro standalone embebe rutas absolutas al directorio de build (/app/apps/web/dist).
WORKDIR /app/apps/web

ENV NODE_ENV=production
ENV HOST=0.0.0.0
ENV PORT=4321

COPY --from=build --chown=node:node /out ./
COPY --chown=node:node docker/web-entrypoint.sh /entrypoint.sh
RUN sed -i 's/\r$//' /entrypoint.sh && chmod +x /entrypoint.sh

USER node
EXPOSE 4321
ENTRYPOINT ["/entrypoint.sh"]
