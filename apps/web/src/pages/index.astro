---
import BaseLayout from '../layouts/BaseLayout.astro';
import LandingQuoteIsland from '../components/landing/LandingQuoteIsland';
import LandingSwitchIsland from '../components/landing/LandingSwitchIsland';
import { FeaturesGrid } from '../components/landing/FeaturesGrid';
import { StatsSection } from '../components/landing/StatsSection';
import { FAQSection } from '../components/landing/FAQSection';
import { resolveLocale, t } from '@velocesport/i18n';

const locale = resolveLocale(Astro.cookies, Astro.request.headers.get('accept-language'));
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const homeHref = base;
const loginHref = `${base}login`;
const signupHref = `${base}signup`;
const logoSrc = `${base}brand/logo-dark-180.webp`;
const whatsappPhone = '+50766003653';
const phoneNumber = '+50766003653';

// Características principales
const features = [
  { icon: '📱', title: 'Captura en Vivo', desc: 'Registra acciones directamente desde la cancha, incluso sin conexión' },
  { icon: '📊', title: 'Reportes Inteligentes', desc: 'Análisis detallado con gráficos y métricas personalizables' },
  { icon: '👨‍👩‍👧‍👦', title: 'Portal Padres', desc: 'Los padres ven el desempeño en tiempo real y reciben alertas' },
  { icon: '🤖', title: 'Insights IA', desc: 'Análisis automático con recomendaciones inteligentes' },
  { icon: '📸', title: 'Almacenamiento Seguro', desc: 'Fotos y videos seguros con URLs firmadas y respaldo automático' },
  { icon: '🔐', title: 'Control Multirol', desc: 'Gestión de roles con permisos granulares y seguros' },
  { icon: '📅', title: 'Calendario Integrado', desc: 'Calendario completo con notificaciones automáticas' },
  { icon: '💰', title: 'Carga de Datos', desc: 'Nuestro equipo carga tus datos iniciales sin costo' },
  { icon: '🌍', title: 'Multi-Tenant SaaS', desc: 'Plataforma segura para cualquier tamaño de academia' },
];

// Beneficios
const benefits = [
  { icon: '⚡', title: 'Rápido y Fácil', desc: 'Sin capacitación necesaria. Comienza en minutos.' },
  { icon: '🎯', title: 'Datos Precisos', desc: 'Reportes exactos en tiempo real para cada jugador.' },
  { icon: '📈', title: 'Mejora Rendimiento', desc: 'Análisis detallados aceleran el desarrollo.' },
  { icon: '💬', title: 'Comunidad Conectada', desc: 'Mantén a todos en sintonía total.' },
  { icon: '🔄', title: 'Funciona Offline', desc: 'Captura sin internet, sincroniza cuando puedas.' },
  { icon: '🛡️', title: 'Seguridad Empresarial', desc: 'Encriptación SSL, backups automáticos.' },
];

interface PlanRow {
  label: string;
  value: string;
}

interface LandingPlan {
  id: 'school' | 'academy' | 'club';
  name: string;
  audience: string;
  example: string;
  rows: PlanRow[];
}

const plans: LandingPlan[] = [
  {
    id: 'school',
    name: t('landing.plans.school.name', locale),
    audience: t('landing.plans.school.for', locale),
    example: t('landing.plans.school.example', locale),
    rows: [
      { label: t('landing.pricing.annual', locale), value: t('landing.plans.school.annual', locale) },
      { label: t('landing.pricing.perPlayer', locale), value: t('landing.plans.school.perPlayer', locale) },
      { label: t('landing.pricing.players', locale), value: t('landing.plans.school.players', locale) },
      { label: t('landing.pricing.minBillable', locale), value: t('landing.plans.school.min', locale) },
      { label: t('landing.pricing.categories', locale), value: t('landing.plans.school.categories', locale) },
      { label: t('landing.pricing.users', locale), value: t('landing.plans.school.users', locale) },
      { label: t('landing.pricing.support', locale), value: t('landing.plans.school.support', locale) },
    ],
  },
  {
    id: 'academy',
    name: t('landing.plans.academy.name', locale),
    audience: t('landing.plans.academy.for', locale),
    example: t('landing.plans.academy.example', locale),
    rows: [
      { label: t('landing.pricing.annual', locale), value: t('landing.plans.academy.annual', locale) },
      { label: t('landing.pricing.perPlayer', locale), value: t('landing.plans.academy.perPlayer', locale) },
      { label: t('landing.pricing.players', locale), value: t('landing.plans.academy.players', locale) },
      { label: t('landing.pricing.minBillable', locale), value: t('landing.plans.academy.min', locale) },
      { label: t('landing.pricing.categories', locale), value: t('landing.plans.academy.categories', locale) },
      { label: t('landing.pricing.users', locale), value: t('landing.plans.academy.users', locale) },
      { label: t('landing.pricing.support', locale), value: t('landing.plans.academy.support', locale) },
    ],
  },
  {
    id: 'club',
    name: t('landing.plans.club.name', locale),
    audience: t('landing.plans.club.for', locale),
    example: t('landing.plans.club.example', locale),
    rows: [
      { label: t('landing.pricing.annual', locale), value: t('landing.plans.club.annual', locale) },
      { label: t('landing.pricing.perPlayer', locale), value: t('landing.plans.club.perPlayer', locale) },
      { label: t('landing.pricing.players', locale), value: t('landing.plans.club.players', locale) },
      { label: t('landing.pricing.minBillable', locale), value: t('landing.plans.club.min', locale) },
      { label: t('landing.pricing.categories', locale), value: t('landing.plans.club.categories', locale) },
      { label: t('landing.pricing.users', locale), value: t('landing.plans.club.users', locale) },
      { label: t('landing.pricing.support', locale), value: t('landing.plans.club.support', locale) },
    ],
  },
];

const familyItems = [
  t('landing.family.capture', locale),
  t('landing.family.report', locale),
  t('landing.family.limit', locale),
];

const pitchPanels = [
  {
    id: 'academy',
    title: t('landing.pitch.academy.title', locale),
    body: t('landing.pitch.academy.body', locale),
    items: [
      t('landing.pitch.academy.school', locale),
      t('landing.pitch.academy.mid', locale),
      t('landing.pitch.academy.club', locale),
    ],
  },
  {
    id: 'parent',
    title: t('landing.pitch.parent.title', locale),
    body: t('landing.pitch.parent.body', locale),
    items: [
      t('landing.pitch.parent.alerts', locale),
      t('landing.pitch.parent.live', locale),
      t('landing.pitch.parent.report', locale),
    ],
  },
  {
    id: 'margin',
    title: t('landing.pitch.margin.title', locale),
    body: t('landing.pitch.margin.body', locale),
    items: [
      t('landing.pitch.margin.included', locale),
      t('landing.pitch.margin.inactive', locale),
      t('landing.pitch.margin.example', locale),
    ],
  },
];

const matchPanels = [
  {
    id: 'attendance',
    title: t('landing.match.attendance.title', locale),
    body: t('landing.match.attendance.body', locale),
  },
  {
    id: 'action',
    title: t('landing.match.action.title', locale),
    body: t('landing.match.action.body', locale),
  },
  {
    id: 'parent',
    title: t('landing.match.parent.title', locale),
    body: t('landing.match.parent.body', locale),
  },
];

const startPanels = [
  {
    id: 'pilot',
    title: t('landing.start.pilot.title', locale),
    body: t('landing.start.pilot.body', locale),
  },
  {
    id: 'tell',
    title: t('landing.start.tell.title', locale),
    body: t('landing.start.tell.body', locale),
  },
  {
    id: 'choose',
    title: t('landing.start.choose.title', locale),
    body: t('landing.start.choose.body', locale),
  },
];

// Estadísticas
const stats = [
  { number: '500+', label: 'Academias Activas' },
  { number: '50K+', label: 'Jugadores Registrados' },
  { number: '100K+', label: 'Partidos Capturados' },
  { number: '99.9%', label: 'Disponibilidad' },
];

// Preguntas Frecuentes
const faqs = [
  {
    question: '¿Cómo funciona el modelo de precios?',
    answer: 'SquadVeloce ofrece un modelo híbrido: una cuota anual base más una tarifa por jugador. Esto significa que solo pagas por los jugadores activos. Tenemos planes adaptados para escuelitas, academias y clubes profesionales.',
  },
  {
    question: '¿Necesito capacitación para usar la plataforma?',
    answer: 'No, nuestro equipo se encarga de cargar tus datos iniciales sin costo. La plataforma es intuitiva y puedes empezar a capturar datos en minutos sin necesidad de capacitación.',
  },
  {
    question: '¿Funciona sin conexión a internet?',
    answer: 'Sí, puedes capturar datos directamente desde la cancha sin conexión. Los datos se sincronizan automáticamente cuando vuelvas a tener internet.',
  },
  {
    question: '¿Cuál es la duración del período de prueba?',
    answer: 'Ofrecemos un período de prueba flexible. Contáctanos vía WhatsApp para discutir los detalles de tu plan piloto personalizado.',
  },
  {
    question: '¿Puedo cambiar de plan después?',
    answer: 'Completamente. Puedes escalar tu plan en cualquier momento sin penalización. Solo contáctanos cuando estés listo para más.',
  },
  {
    question: '¿Puedo exportar mis datos?',
    answer: 'Sí, tus datos te pertenecen. Puedes exportarlos en cualquier momento. Ofrecemos múltiples formatos compatibles con Excel y otras herramientas.',
  },
];
---

<BaseLayout
  locale={locale}
  title={t('landing.metaTitle', locale)}
  description={t('landing.metaDescription', locale)}
>
  <div class="ds-landing">
    <a class="ds-landing__skip" href="#contenido">{t('landing.skipToContent', locale)}</a>

    <header class="ds-landing__header">
      <div class="ds-landing__wrap ds-landing__header-bar">
        <a class="ds-landing__brand" href={homeHref} aria-label={t('common.appName', locale)}>
          <img
            src={logoSrc}
            alt={t('common.appName', locale)}
            width="180"
            height="180"
            class="ds-landing__logo"
            decoding="async"
            fetchpriority="high"
          />
        </a>
        <nav class="ds-landing__nav" aria-label={t('landing.navLabel', locale)}>
          <a class="ds-landing__jump" href="#beneficio">{t('landing.nav.benefit', locale)}</a>
          <a class="ds-landing__jump" href="#partido">{t('landing.nav.match', locale)}</a>
          <a class="ds-landing__jump" href="#precios">{t('landing.nav.pricing', locale)}</a>
          <a class="ds-landing__jump" href="#empezar">{t('landing.nav.start', locale)}</a>
          <a class="ds-landing__ghost" href={signupHref}>{t('landing.nav.signup', locale)}</a>
          <a class="ds-landing__cta ds-btn-sport ds-btn-sport--primary" href={loginHref}>
            {t('landing.nav.login', locale)}
          </a>
        </nav>
      </div>
    </header>

    <main id="contenido">
      <section class="ds-landing__hero" aria-labelledby="landing-hero-title">
        <div class="ds-landing__wrap ds-landing__hero-inner">
          <p class="ds-landing__kicker">{t('common.brandSlogan', locale)}</p>
          <h1 id="landing-hero-title">{t('landing.hero.headline', locale)}</h1>
          <p class="ds-landing__lead">{t('landing.hero.lead', locale)}</p>
          <div class="ds-landing__actions">
            <a class="ds-landing__cta ds-btn-sport ds-btn-sport--primary" href={loginHref}>
              {t('landing.nav.login', locale)}
            </a>
            <a class="ds-landing__ghost" href={signupHref}>{t('landing.nav.signup', locale)}</a>
          </div>
        </div>
      </section>

      <section class="ds-landing__section" aria-labelledby="landing-features-title">
        <div class="ds-landing__wrap">
          <h2 id="landing-features-title">{t('landing.pitch.title', locale)}</h2>
          <p class="ds-landing__section-lead">{t('landing.pitch.lead', locale)}</p>
          <FeaturesGrid client:load features={features} />
        </div>
      </section>

      <section class="ds-landing__section" id="beneficio" aria-labelledby="landing-pitch-title">
        <div class="ds-landing__wrap">
          <h2 id="landing-pitch-title">{t('landing.pitch.title', locale)}</h2>
          <p class="ds-landing__section-lead">{t('landing.pitch.lead', locale)}</p>
          <div id="landing-pitch" class="ds-landing__switch">
            <LandingSwitchIsland client:load group="pitch" initialLocale={locale} />
            {
              pitchPanels.map((panel) => (
                <article class="ds-landing__switch-panel" id={`pitch-${panel.id}`} data-switch-panel={panel.id}>
                  <h3>{panel.title}</h3>
                  <p>{panel.body}</p>
                  <ul class="ds-landing__checks">
                    {panel.items.map((item) => (
                      <li>
                        <svg class="ds-landing__mark" viewBox="0 0 20 20" aria-hidden="true" focusable="false">
                          <path
                            d="M4 10.5 8 14.5 16 6"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="2"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                          />
                        </svg>
                        <span>{item}</span>
                      </li>
                    ))}
                  </ul>
                </article>
              ))
            }
          </div>
        </div>
      </section>

      <section class="ds-landing__section ds-landing__section--muted" id="partido" aria-labelledby="landing-match-title">
        <div class="ds-landing__wrap">
          <h2 id="landing-match-title">{t('landing.match.title', locale)}</h2>
          <p class="ds-landing__section-lead">{t('landing.match.lead', locale)}</p>
          <div id="landing-match" class="ds-landing__switch">
            <LandingSwitchIsland client:load group="match" initialLocale={locale} />
            <ol class="ds-landing__switch-steps">
              {
                matchPanels.map((panel, index) => (
                  <li class="ds-landing__switch-panel" id={`match-${panel.id}`} data-switch-panel={panel.id}>
                    <p class="ds-landing__step-index">{index + 1}</p>
                    <h3>{panel.title}</h3>
                    <p>{panel.body}</p>
                  </li>
                ))
              }
            </ol>
          </div>
        </div>
      </section>

      <section class="ds-landing__section" id="precios" aria-labelledby="landing-pricing-title">
        <div class="ds-landing__wrap">
          <h2 id="landing-pricing-title">{t('landing.pricing.title', locale)}</h2>
          <p class="ds-landing__section-lead">{t('landing.pricing.lead', locale)}</p>
          <p class="ds-landing__section-lead">{t('landing.pricing.boundary', locale)}</p>
          <LandingQuoteIsland client:visible initialLocale={locale} />
          <ul class="ds-landing__plans">
            {
              plans.map((plan) => (
                <li class="ds-landing__plan" data-plan={plan.id}>
                  <h3>{plan.name}</h3>
                  <p class="ds-landing__plan-for">{plan.audience}</p>
                  <p class="ds-landing__plan-example">
                    <span>{t('landing.pricing.example', locale)}</span>
                    {plan.example}
                  </p>
                  <dl>
                    {plan.rows.map((row) => (
                      <div>
                        <dt>{row.label}</dt>
                        <dd>{row.value}</dd>
                      </div>
                    ))}
                  </dl>
                </li>
              ))
            }
          </ul>

          <aside class="ds-landing__family" data-plan="family">
            <div>
              <h3>{t('landing.family.title', locale)}</h3>
              <p class="ds-landing__plan-example">{t('landing.family.price', locale)}</p>
              <p>{t('landing.family.lead', locale)}</p>
              <ul class="ds-landing__checks">
                {familyItems.map((item) => (
                  <li>
                    <svg class="ds-landing__mark" viewBox="0 0 20 20" aria-hidden="true" focusable="false">
                      <path
                        d="M4 10.5 8 14.5 16 6"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                      />
                    </svg>
                    <span>{item}</span>
                  </li>
                ))}
              </ul>
            </div>
            <a class="ds-landing__cta ds-btn-sport ds-btn-sport--primary" href={signupHref}>
              {t('landing.family.cta', locale)}
            </a>
          </aside>
        </div>
      </section>

      <section class="ds-landing__section">
        <div class="ds-landing__wrap">
          <StatsSection client:load stats={stats} />
        </div>
      </section>

      <section class="ds-landing__section ds-landing__section--muted" id="empezar" aria-labelledby="landing-start-title">
        <div class="ds-landing__wrap">
          <h2 id="landing-start-title">{t('landing.start.title', locale)}</h2>
          <p class="ds-landing__section-lead">{t('landing.start.lead', locale)}</p>
          <div id="landing-start" class="ds-landing__switch">
            <LandingSwitchIsland client:load group="start" initialLocale={locale} />
            <ol class="ds-landing__switch-steps">
              {
                startPanels.map((panel, index) => (
                  <li class="ds-landing__switch-panel" id={`start-${panel.id}`} data-switch-panel={panel.id}>
                    <p class="ds-landing__step-index">{index + 1}</p>
                    <h3>{panel.title}</h3>
                    <p>{panel.body}</p>
                  </li>
                ))
              }
            </ol>
          </div>
          <p class="ds-landing__note">{t('landing.start.extras', locale)}</p>
        </div>
      </section>

      <section class="ds-landing__section">
        <div class="ds-landing__wrap">
          <FAQSection client:load faqs={faqs} title={t('landing.pricing.title', locale)} />
        </div>
      </section>
    </main>

    <footer class="ds-landing__footer">
      <div class="ds-landing__wrap ds-landing__footer-inner">
        <p class="ds-landing__kicker">{t('common.brandSlogan', locale)}</p>
        <p>{t('landing.footer.note', locale)}</p>
        <p style="font-size: 0.9rem; color: rgba(255, 255, 255, 0.7); margin-top: 1.5rem;">
          📱 WhatsApp: <a href={`https://wa.me/${whatsappPhone.replace(/[^0-9]/g, '')}`} style="color: #a3e635; text-decoration: none;">{phoneNumber}</a>
          {' '}|{' '}
          📞 Teléfono: {phoneNumber}
        </p>
        <p style="font-size: 0.85rem; color: rgba(255, 255, 255, 0.5); margin-top: 1rem;">
          🌍 Disponible en: Panamá 🇵🇦 | Colombia 🇨🇴 | México 🇲🇽 | Estados Unidos 🇺🇸
        </p>
        <div class="ds-landing__actions">
          <a class="ds-landing__cta ds-btn-sport ds-btn-sport--primary" href={loginHref}>
            {t('landing.nav.login', locale)}
          </a>
          <a class="ds-landing__ghost" href={signupHref}>{t('landing.nav.signup', locale)}</a>
        </div>
      </div>
    </footer>
  </div>
</BaseLayout>
