---
import BaseLayout from '../layouts/BaseLayout.astro';
import { resolveLocale, t } from '@velocesport/i18n';

const locale = resolveLocale(Astro.cookies, Astro.request.headers.get('accept-language'));
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const homeHref = base;
const loginHref = `${base}login`;
const signupHref = `${base}signup`;
const logoSrc = `${base}brand/logo-dark-180.webp`;
const whatsappPhone = '+50766003653';
const phoneNumber = '+50766003653';

// Características principales con explicaciones
const features = [
  {
    icon: '📱',
    title: 'Captura en Vivo',
    desc: 'Registra todas las acciones del partido directamente desde la cancha',
    details: 'Funciona incluso sin conexión a internet. Los datos se sincronizan automáticamente cuando recuperas conexión, garantizando que nunca pierdas información importante.'
  },
  {
    icon: '📊',
    title: 'Reportes Detallados',
    desc: 'Análisis completo del desempeño de cada jugador',
    details: 'Gráficos interactivos, estadísticas personalizables y métricas en tiempo real para mejorar la toma de decisiones.'
  },
  {
    icon: '👨‍👩‍👧‍👦',
    title: 'Portal para Padres',
    desc: 'Los padres ven el progreso en tiempo real',
    details: 'Acceso seguro al desempeño de sus hijos, alertas automáticas y comunicación directa con los entrenadores.'
  },
  {
    icon: '📸',
    title: 'Almacenamiento Seguro',
    desc: 'Fotos y videos de partidos protegidos',
    details: 'Almacenamiento en la nube con encriptación, URLs firmadas para acceso seguro y respaldo automático de todos tus datos.'
  },
  {
    icon: '🔐',
    title: 'Control de Roles',
    desc: 'Gestión granular de permisos de usuarios',
    details: 'Define quién puede ver qué información. Administradores, entrenadores, padres y jugadores tienen acceso diferenciado y seguro.'
  },
  {
    icon: '📅',
    title: 'Calendario Integrado',
    desc: 'Organiza todos tus eventos y partidos',
    details: 'Notificaciones automáticas, sincronización con calendarios externos y recordatorios para no perder ningún evento importante.'
  },
];

// Estadísticas
const stats = [
  { number: '500+', label: 'Academias Activas' },
  { number: '50K+', label: 'Jugadores Registrados' },
  { number: '100K+', label: 'Partidos Capturados' },
  { number: '99.9%', label: 'Disponibilidad' },
];

---

<BaseLayout
  locale={locale}
  title={t('landing.metaTitle', locale)}
  description={t('landing.metaDescription', locale)}
>
  <style>
    .landing-hero {
      background: linear-gradient(135deg, rgba(163, 230, 53, 0.1) 0%, transparent 50%);
      padding: 6rem 2rem;
      text-align: center;
      position: relative;
      overflow: hidden;
    }

    .landing-hero::before {
      content: '';
      position: absolute;
      top: -50%;
      right: -10%;
      width: 600px;
      height: 600px;
      background: radial-gradient(circle, rgba(163, 230, 53, 0.15) 0%, transparent 70%);
      border-radius: 50%;
      z-index: 0;
    }

    .landing-hero-content {
      position: relative;
      z-index: 1;
      max-width: 900px;
      margin: 0 auto;
    }

    .landing-hero h1 {
      font-size: clamp(2rem, 8vw, 4rem);
      font-weight: 800;
      margin-bottom: 1.5rem;
      background: linear-gradient(135deg, #0b0b0f 0%, #a3e635 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
      line-height: 1.2;
    }

    .landing-hero p {
      font-size: 1.25rem;
      color: #52525b;
      margin-bottom: 2rem;
    }

    .landing-hero .location {
      display: inline-block;
      background: rgba(163, 230, 53, 0.15);
      color: #a3e635;
      padding: 0.5rem 1rem;
      border-radius: 20px;
      font-size: 0.9rem;
      font-weight: 600;
      margin-bottom: 1.5rem;
    }

    .landing-actions {
      display: flex;
      gap: 1rem;
      justify-content: center;
      flex-wrap: wrap;
      margin-top: 2rem;
    }

    .landing-section {
      padding: 5rem 2rem;
      max-width: 1280px;
      margin: 0 auto;
    }

    .landing-section h2 {
      font-size: 2.5rem;
      font-weight: 800;
      margin-bottom: 3rem;
      text-align: center;
      color: #0b0b0f;
    }

    .features-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(340px, 1fr));
      gap: 2rem;
    }

    .feature-card {
      background: white;
      padding: 2rem;
      border-radius: 12px;
      border: 1px solid #e4e4e7;
      transition: all 0.3s ease;
      position: relative;
      overflow: hidden;
    }

    .feature-card::before {
      content: '';
      position: absolute;
      top: 0;
      left: 0;
      width: 4px;
      height: 100%;
      background: #a3e635;
      transform: scaleY(0);
      transform-origin: top;
      transition: transform 0.3s;
    }

    .feature-card:hover {
      border-color: #a3e635;
      box-shadow: 0 10px 30px rgba(163, 230, 53, 0.15);
      transform: translateY(-5px);
    }

    .feature-card:hover::before {
      transform: scaleY(1);
    }

    .feature-icon {
      font-size: 2.5rem;
      margin-bottom: 1rem;
      display: block;
    }

    .feature-card h3 {
      font-size: 1.25rem;
      margin-bottom: 0.75rem;
      color: #111827;
      font-weight: 600;
    }

    .feature-card p {
      color: #52525b;
      line-height: 1.6;
      font-size: 0.95rem;
      margin-bottom: 1rem;
    }

    .feature-details {
      color: #71717a;
      font-size: 0.85rem;
      line-height: 1.5;
      border-top: 1px solid #e4e4e7;
      padding-top: 1rem;
      margin-top: 1rem;
    }

    .stats-container {
      background: linear-gradient(135deg, rgba(163, 230, 53, 0.15) 0%, transparent 50%);
      padding: 3rem 0;
      border-radius: 16px;
    }

    .stats-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
      gap: 2rem;
      text-align: center;
    }

    .stat-item {
      padding: 1.5rem;
    }

    .stat-number {
      font-size: 2.5rem;
      font-weight: 800;
      color: #a3e635;
      margin-bottom: 0.5rem;
    }

    .stat-label {
      font-size: 0.95rem;
      color: #52525b;
      font-weight: 500;
    }

    .pricing-section {
      background: #f9fafb;
      padding: 5rem 2rem;
    }

    .pricing-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
      gap: 2rem;
      margin-top: 3rem;
    }

    .pricing-card {
      background: white;
      padding: 2.5rem;
      border-radius: 12px;
      border: 2px solid #e4e4e7;
      transition: all 0.3s ease;
    }

    .pricing-card:hover {
      border-color: #a3e635;
      box-shadow: 0 10px 30px rgba(163, 230, 53, 0.2);
      transform: translateY(-5px);
    }

    .pricing-card h3 {
      font-size: 1.5rem;
      color: #111827;
      margin-bottom: 1rem;
      font-weight: 700;
    }

    .pricing-card p {
      color: #52525b;
      margin-bottom: 1.5rem;
      font-size: 0.9rem;
    }

    .pricing-list {
      list-style: none;
      margin-top: 1.5rem;
    }

    .pricing-list li {
      padding: 0.75rem 0;
      border-bottom: 1px solid #e4e4e7;
      display: flex;
      justify-content: space-between;
      font-size: 0.95rem;
      color: #52525b;
    }

    .pricing-list li:last-child {
      border-bottom: none;
    }

    .pricing-list strong {
      color: #a3e635;
      font-weight: 600;
    }

    .cta-button {
      display: inline-block;
      background: #a3e635;
      color: #0b0b0f;
      padding: 0.875rem 2rem;
      border-radius: 6px;
      font-weight: 600;
      text-decoration: none;
      transition: all 0.3s ease;
      border: none;
      cursor: pointer;
      font-size: 1rem;
      margin-top: 1.5rem;
    }

    .cta-button:hover {
      background: #84cc16;
      transform: translateY(-2px);
      box-shadow: 0 10px 25px rgba(163, 230, 53, 0.2);
    }

    .footer-section {
      background: #0b0b0f;
      color: white;
      padding: 3rem 2rem;
      text-align: center;
    }

    .footer-section p {
      margin-bottom: 1.5rem;
      color: rgba(255, 255, 255, 0.7);
    }

    .footer-section a {
      color: #a3e635;
      text-decoration: none;
      font-weight: 600;
    }

    .footer-section a:hover {
      text-decoration: underline;
    }
  </style>

  <div class="landing-hero">
    <div class="landing-hero-content">
      <div class="location">🇵🇦 Disponible en Panamá, Colombia, México y EE.UU.</div>
      <h1>Gestión Profesional de Academias de Fútbol</h1>
      <p>SquadVeloce es la plataforma líder para academias de fútbol que buscan capturar datos en tiempo real, mejorar el rendimiento de sus jugadores y conectar con padres.</p>
      <div class="landing-actions">
        <a class="cta-button" href={signupHref}>Comenzar Gratis</a>
        <a class="cta-button" style="background: transparent; border: 2px solid #a3e635; color: #a3e635;" href={loginHref}>Inicia Sesión</a>
      </div>
    </div>
  </div>

  <div class="landing-section">
    <h2>Características Principales</h2>
    <div class="features-grid">
      {features.map((feature) => (
        <div class="feature-card">
          <div class="feature-icon">{feature.icon}</div>
          <h3>{feature.title}</h3>
          <p>{feature.desc}</p>
          <div class="feature-details">{feature.details}</div>
        </div>
      ))}
    </div>
  </div>

  <div class="landing-section">
    <h2>Nuestro Impacto</h2>
    <div class="stats-container">
      <div class="stats-grid">
        {stats.map((stat) => (
          <div class="stat-item">
            <div class="stat-number">{stat.number}</div>
            <div class="stat-label">{stat.label}</div>
          </div>
        ))}
      </div>
    </div>
  </div>

  <div class="pricing-section">
    <div style="max-width: 1280px; margin: 0 auto; padding: 0 2rem;">
      <h2>Planes de Precios Adaptados</h2>
      <div class="pricing-grid">
        <div class="pricing-card">
          <h3>Escuelita</h3>
          <p>Perfecto para iniciantes</p>
          <p style="color: #a3e635; font-size: 1.5rem; font-weight: 700;">$0 - $99/año</p>
          <p style="color: #52525b; font-size: 0.9rem;">+ $1.50 por jugador/mes</p>
          <ul class="pricing-list">
            <li><span>Hasta 60 jugadores</span> <strong>✓</strong></li>
            <li><span>Captura en vivo</span> <strong>✓</strong></li>
            <li><span>Portal de padres</span> <strong>✓</strong></li>
            <li><span>Reportes básicos</span> <strong>✓</strong></li>
          </ul>
          <a class="cta-button" href={signupHref}>Seleccionar Plan</a>
        </div>

        <div class="pricing-card">
          <h3>Academia</h3>
          <p>La opción más popular</p>
          <p style="color: #a3e635; font-size: 1.5rem; font-weight: 700;">$199/año</p>
          <p style="color: #52525b; font-size: 0.9rem;">+ $1.25 por jugador/mes (mín. 70)</p>
          <ul class="pricing-list">
            <li><span>70 - 200 jugadores</span> <strong>✓</strong></li>
            <li><span>Todo de Escuelita</span> <strong>✓</strong></li>
            <li><span>Reportes avanzados</span> <strong>✓</strong></li>
            <li><span>Múltiples categorías</span> <strong>✓</strong></li>
          </ul>
          <a class="cta-button" href={signupHref}>Seleccionar Plan</a>
        </div>

        <div class="pricing-card">
          <h3>Club</h3>
          <p>Para clubes profesionales</p>
          <p style="color: #a3e635; font-size: 1.5rem; font-weight: 700;">$399/año</p>
          <p style="color: #52525b; font-size: 0.9rem;">+ $1.00 por jugador/mes (mín. 240)</p>
          <ul class="pricing-list">
            <li><span>240 - 600 jugadores</span> <strong>✓</strong></li>
            <li><span>Todo de Academia</span> <strong>✓</strong></li>
            <li><span>Soporte prioritario</span> <strong>✓</strong></li>
            <li><span>Integraciones custom</span> <strong>✓</strong></li>
          </ul>
          <a class="cta-button" href={signupHref}>Seleccionar Plan</a>
        </div>
      </div>
    </div>
  </div>

  <div class="footer-section">
    <h3 style="margin-bottom: 1rem; font-size: 1.5rem;">¿Preguntas? Contáctanos</h3>
    <p>
      📱 WhatsApp: <a href={`https://wa.me/${whatsappPhone.replace(/[^0-9]/g, '')}`}>{phoneNumber}</a>
    </p>
    <p>
      📞 Teléfono: {phoneNumber}
    </p>
    <p style="margin-top: 2rem; border-top: 1px solid rgba(255, 255, 255, 0.1); padding-top: 2rem;">
      <strong>SquadVeloce</strong> — Plataforma SaaS para gestión de academias de fútbol
    </p>
    <div class="landing-actions" style="justify-content: center; margin-top: 2rem;">
      <a class="cta-button" href={signupHref}>Comenzar Ahora</a>
    </div>
  </div>
</BaseLayout>
