  <script>
    const basePrice = {
      USD: {
        school: { annual: 0, perPlayer: 1.50 },
        academy: { annual: 199, perPlayer: 1.25 },
        club: { annual: 399, perPlayer: 1.00 }
      }
    };

    const exchangeRates = {
      EUR: 0.92,
      COP: 3850,
      MXN: 17.05,
      USD: 1
    };

    const currencyFormats = {
      USD: (val) => `$${val.toFixed(2)}`,
      EUR: (val) => `€${val.toFixed(2)}`,
      COP: (val) => `$${Math.round(val).toLocaleString('es-CO')}`,
      MXN: (val) => `$${val.toFixed(2)}`
    };

    function updatePrices() {
      const currency = document.getElementById('currency-select').value;
      const rate = exchangeRates[currency];
      const format = currencyFormats[currency];

      document.getElementById('price-school-player').textContent = format(basePrice.USD.school.perPlayer * rate);
      document.getElementById('price-academy-annual').textContent = format(basePrice.USD.academy.annual * rate) + '/año';
      document.getElementById('price-academy-player').textContent = format(basePrice.USD.academy.perPlayer * rate);
      document.getElementById('price-club-annual').textContent = format(basePrice.USD.club.annual * rate) + '/año';
      document.getElementById('price-club-player').textContent = format(basePrice.USD.club.perPlayer * rate);

      updateExchangeInfo(currency);
      calculatePrice();
    }

    function updateExchangeInfo(currency) {
      const info = document.getElementById('exchange-info');
      const rate = exchangeRates[currency];
      const date = new Date().toLocaleDateString('es-ES');
      info.textContent = `1 USD = ${rate} ${currency} (actualizado: ${date})`;
    }

    function calculatePrice() {
      const players = parseInt(document.getElementById('players-count').value) || 50;
      const plan = document.getElementById('plan-select').value;
      const years = parseInt(document.getElementById('years-count').value) || 1;
      const currency = document.getElementById('currency-select').value;
      const rate = exchangeRates[currency];
      const format = currencyFormats[currency];

      const pricing = basePrice.USD[plan];
      const monthlyPlayer = pricing.perPlayer * rate * players;
      const annualFee = pricing.annual * rate;
      const totalAnnual = annualFee + (monthlyPlayer * 12);
      const totalInvestment = totalAnnual * years;

      document.getElementById('monthly-price').textContent = format(monthlyPlayer);
      document.getElementById('annual-price').textContent = format(totalAnnual);
      document.getElementById('total-price').textContent = format(totalInvestment);
    }

    async function fetchRealRates() {
      try {
        const response = await fetch('https://api.exchangerate-api.com/v4/latest/USD');
        const data = await response.json();
        if (data.rates) {
          exchangeRates.EUR = data.rates.EUR;
          exchangeRates.COP = data.rates.COP;
          exchangeRates.MXN = data.rates.MXN;
        }
      } catch (error) {
        console.log('Usando tasas predeterminadas');
      }
      updatePrices();
    }

    document.addEventListener('DOMContentLoaded', () => {
      fetchRealRates();
    });

    document.querySelectorAll('a[href^="#"]').forEach(anchor => {
      anchor.addEventListener('click', function(e) {
        e.preventDefault();
        const target = document.querySelector(this.getAttribute('href'));
        if (target) {
          target.scrollIntoView({ behavior: 'smooth' });
        }
      });
    });
  </script>
