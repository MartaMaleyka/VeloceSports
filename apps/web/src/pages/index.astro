---
import BaseLayout from '../layouts/BaseLayout.astro';
import { resolveLocale, t } from '@velocesport/i18n';

const locale = resolveLocale(Astro.cookies, Astro.request.headers.get('accept-language'));
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const loginHref = `${base}login`;
const signupHref = `${base}signup`;
const logoSrc = `${base}brand/logo-dark-180.webp`;
---

<BaseLayout
  locale={locale}
  title={t('landing.metaTitle', locale)}
  description={t('landing.metaDescription', locale)}
>
  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    :root {
      --brand-primary: #a3e635;
      --brand-primary-bright: #b8f235;
      --brand-primary-dark: #7ec914;
      --brand-hover: #84cc16;
      --brand-dark: #0b0b0f;
      --brand-ink: #111827;
      --neutral-50: #fafafa;
      --neutral-100: #f4f4f5;
      --neutral-200: #e4e4e7;
      --neutral-600: #52525b;
      --neutral-900: #18181b;
    }

    :global(body) {
      font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', sans-serif;
      line-height: 1.6;
      color: var(--brand-ink);
      background: linear-gradient(135deg, #f8fafc 0%, #ffffff 100%);
    }

    /* Animaciones dinámicas */
    @keyframes fadeInUp {
      from {
        opacity: 0;
        transform: translateY(30px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    @keyframes slideInLeft {
      from {
        opacity: 0;
        transform: translateX(-50px);
      }
      to {
        opacity: 1;
        transform: translateX(0);
      }
    }

    @keyframes pulse-glow {
      0%, 100% {
        box-shadow: 0 0 20px rgba(163, 230, 53, 0.4), 0 0 40px rgba(163, 230, 53, 0.2);
      }
      50% {
        box-shadow: 0 0 30px rgba(163, 230, 53, 0.6), 0 0 60px rgba(163, 230, 53, 0.3);
      }
    }

    @keyframes float {
      0%, 100% {
        transform: translateY(0px);
      }
      50% {
        transform: translateY(-10px);
      }
    }

    @keyframes shimmer {
      0% {
        background-position: -1000px 0;
      }
      100% {
        background-position: 1000px 0;
      }
    }

    @keyframes rotate-icon {
      from {
        transform: rotate(0deg) scale(1);
      }
      to {
        transform: rotate(360deg) scale(1.1);
      }
    }

    @keyframes flip-card {
      0% {
        transform: rotateY(0deg);
      }
      100% {
        transform: rotateY(360deg);
      }
    }

    @keyframes bounce-in {
      0% {
        opacity: 0;
        transform: translateY(20px) scale(0.9);
      }
      50% {
        transform: translateY(-5px);
      }
      100% {
        opacity: 1;
        transform: translateY(0) scale(1);
      }
    }

    @keyframes glow-pulse {
      0%, 100% {
        box-shadow: 0 0 10px rgba(163, 230, 53, 0.3);
      }
      50% {
        box-shadow: 0 0 30px rgba(163, 230, 53, 0.7);
      }
    }

    @keyframes neon-glow {
      0%, 100% {
        text-shadow: 0 0 10px rgba(163, 230, 53, 0.5), 0 0 20px rgba(163, 230, 53, 0.3);
      }
      50% {
        text-shadow: 0 0 20px rgba(163, 230, 53, 0.8), 0 0 40px rgba(163, 230, 53, 0.5);
      }
    }

    /* Header - Minimalista */
    header {
      background: transparent;
      padding: 1.5rem 0;
      position: fixed;
      top: 0;
      left: 0;
      right: 0;
      z-index: 1000;
      backdrop-filter: blur(10px);
      background: rgba(255, 255, 255, 0.8);
    }

    .container {
      max-width: 1280px;
      margin: 0 auto;
      padding: 0 2rem;
    }

    header .container {
      display: flex;
      justify-content: flex-end;
      align-items: center;
      gap: 3rem;
      padding: 0 2rem;
    }

    .logo {
      display: none;
    }

    nav {
      display: flex;
      gap: 2.5rem;
      align-items: center;
    }

    nav a {
      color: var(--brand-ink);
      text-decoration: none;
      font-weight: 600;
      transition: all 0.3s;
      position: relative;
      font-size: 0.95rem;
      letter-spacing: -0.01em;
    }

    nav a::after {
      content: '';
      position: absolute;
      bottom: -8px;
      left: 0;
      width: 0;
      height: 2px;
      background: var(--brand-primary);
      transition: width 0.3s;
    }

    nav a:hover {
      color: var(--brand-primary);
    }

    nav a:hover::after {
      width: 100%;
    }

    .btn {
      padding: 0.85rem 1.8rem;
      border: none;
      border-radius: 8px;
      font-size: 1rem;
      font-weight: 700;
      cursor: pointer;
      transition: all 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
      text-decoration: none;
      display: inline-block;
      position: relative;
      overflow: hidden;
    }

    .btn::before {
      content: '';
      position: absolute;
      top: 0;
      left: -100%;
      width: 100%;
      height: 100%;
      background: rgba(255, 255, 255, 0.2);
      transition: left 0.3s;
    }

    .btn:hover::before {
      left: 100%;
    }

    .btn-primary {
      background: linear-gradient(135deg, var(--brand-primary) 0%, var(--brand-primary-bright) 100%);
      color: var(--brand-dark);
      box-shadow: 0 8px 24px rgba(163, 230, 53, 0.3);
    }

    .btn-primary:hover {
      transform: translateY(-4px);
      box-shadow: 0 16px 48px rgba(163, 230, 53, 0.5);
      background: linear-gradient(135deg, var(--brand-primary-bright) 0%, var(--brand-primary) 100%);
    }

    .btn-secondary {
      background: transparent;
      color: var(--brand-primary);
      border: 2px solid var(--brand-primary);
      box-shadow: 0 0 20px rgba(163, 230, 53, 0.2);
    }

    .btn-secondary:hover {
      background: var(--brand-primary);
      color: var(--brand-dark);
      box-shadow: 0 8px 24px rgba(163, 230, 53, 0.4);
      transform: translateY(-2px);
    }

    /* Hero Section - ULTRA MODERNO E IMPACTANTE */
    .hero {
      padding: 120px 0 80px;
      background: linear-gradient(135deg, #0b0b0f 0%, #1a1a2e 50%, #16213e 100%);
      position: relative;
      overflow: hidden;
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .hero::before {
      content: '';
      position: absolute;
      top: -30%;
      right: -15%;
      width: 900px;
      height: 900px;
      background: radial-gradient(circle, rgba(163, 230, 53, 0.4) 0%, rgba(163, 230, 53, 0.1) 30%, transparent 70%);
      border-radius: 50%;
      z-index: 1;
      animation: float 8s ease-in-out infinite;
      filter: blur(40px);
    }

    .hero::after {
      content: '';
      position: absolute;
      bottom: -40%;
      left: -10%;
      width: 800px;
      height: 800px;
      background: radial-gradient(circle, rgba(163, 230, 53, 0.3) 0%, rgba(163, 230, 53, 0.05) 40%, transparent 70%);
      border-radius: 50%;
      z-index: 1;
      animation: float 10s ease-in-out infinite reverse;
      filter: blur(50px);
    }

    .hero-content {
      position: relative;
      z-index: 2;
      text-align: center;
      animation: fadeInUp 1.2s ease-out;
    }

    .hero-logo {
      margin-bottom: 3rem;
      animation: fadeInUp 0.8s ease-out;
      display: flex;
      justify-content: center;
      align-items: center;
      width: 100%;
    }

    .hero-logo img {
      height: 180px;
      width: auto;
      display: block;
      filter: drop-shadow(0 20px 60px rgba(163, 230, 53, 0.6));
      transition: all 0.4s cubic-bezier(0.34, 1.56, 0.64, 1);
      animation: float 4s ease-in-out infinite;
    }

    .hero-logo img:hover {
      filter: drop-shadow(0 30px 80px rgba(163, 230, 53, 0.8));
      transform: scale(1.08);
    }

    .hero h1 {
      font-size: clamp(3rem, 12vw, 5.5rem);
      font-weight: 900;
      margin-bottom: 2rem;
      background: linear-gradient(135deg, var(--brand-primary-bright) 0%, var(--brand-primary) 50%, #7aea5e 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
      line-height: 1.1;
      letter-spacing: -0.03em;
      animation: neon-glow 3s ease-in-out infinite;
    }

    .hero p {
      font-size: 1.45rem;
      color: rgba(255, 255, 255, 0.85);
      margin-bottom: 3rem;
      max-width: 800px;
      margin-left: auto;
      margin-right: auto;
      animation: fadeInUp 1.3s ease-out 0.2s both;
      line-height: 1.8;
      font-weight: 500;
      letter-spacing: -0.01em;
    }

    .hero .location {
      display: inline-block;
      background: linear-gradient(135deg, rgba(163, 230, 53, 0.35) 0%, rgba(163, 230, 53, 0.2) 100%);
      color: var(--brand-primary-bright);
      padding: 1rem 1.8rem;
      border-radius: 30px;
      font-size: 1.05rem;
      font-weight: 700;
      margin-bottom: 2.5rem;
      border: 2px solid var(--brand-primary);
      animation: fadeInUp 1.5s ease-out 0.3s both;
      box-shadow: 0 15px 50px rgba(163, 230, 53, 0.4);
      backdrop-filter: blur(10px);
      letter-spacing: -0.01em;
    }

    .hero-actions {
      display: flex;
      gap: 2rem;
      justify-content: center;
      flex-wrap: wrap;
      animation: fadeInUp 1.8s ease-out 0.5s both;
    }

    /* Features Section */
    .section {
      padding: 6rem 0;
    }

    .section h2 {
      font-size: 2.8rem;
      font-weight: 900;
      margin-bottom: 1rem;
      text-align: center;
      color: var(--brand-dark);
      background: linear-gradient(135deg, var(--brand-dark) 0%, var(--brand-primary-dark) 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
      letter-spacing: -0.01em;
    }

    .section > .container > p {
      text-align: center;
      color: var(--neutral-600);
      font-size: 1.1rem;
      margin-bottom: 3rem;
      max-width: 700px;
      margin-left: auto;
      margin-right: auto;
    }

    .features-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
      gap: 2.5rem;
    }

    .feature-card {
      background: white;
      padding: 2.5rem;
      border-radius: 16px;
      border: 2px solid var(--neutral-200);
      transition: all 0.4s cubic-bezier(0.34, 1.56, 0.64, 1);
      position: relative;
      overflow: hidden;
      animation: fadeInUp 0.8s ease-out both;
      perspective: 1000px;
      cursor: pointer;
    }

    .feature-card:nth-child(1) { animation-delay: 0.1s; }
    .feature-card:nth-child(2) { animation-delay: 0.2s; }
    .feature-card:nth-child(3) { animation-delay: 0.3s; }
    .feature-card:nth-child(4) { animation-delay: 0.4s; }
    .feature-card:nth-child(5) { animation-delay: 0.5s; }
    .feature-card:nth-child(6) { animation-delay: 0.6s; }

    .feature-card:hover {
      transform: translateY(-12px) rotateY(5deg) rotateX(-5deg);
      box-shadow: 0 20px 60px rgba(163, 230, 53, 0.3);
      border-color: var(--brand-primary);
    }

    .feature-card.active-feature {
      animation: glow-pulse 2s ease-in-out infinite;
    }

    .feature-card::before {
      content: '';
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 4px;
      background: linear-gradient(90deg, var(--brand-primary) 0%, var(--brand-primary-bright) 100%);
      transform: scaleX(0);
      transform-origin: left;
      transition: transform 0.4s;
    }

    .feature-card:hover::before {
      transform: scaleX(1);
    }

    .feature-card:hover {
      border-color: var(--brand-primary);
      box-shadow: 0 20px 50px rgba(163, 230, 53, 0.25);
      transform: translateY(-8px);
      background: linear-gradient(135deg, rgba(163, 230, 53, 0.08) 0%, white 100%);
    }

    .feature-icon {
      font-size: 3.5rem;
      margin-bottom: 1.5rem;
      display: inline-block;
      animation: float 3s ease-in-out infinite;
      transition: all 0.3s;
    }

    .feature-card:hover .feature-icon {
      animation: rotate-icon 0.6s ease-in-out;
    }

    .feature-card h3 {
      font-size: 1.6rem;
      margin-bottom: 1rem;
      color: var(--brand-dark);
      font-weight: 800;
    }

    .feature-card p {
      color: var(--neutral-600);
      line-height: 1.8;
      font-size: 1.05rem;
    }

    /* Benefits Section - SUPER ENERGÉTICA */
    .benefits-section {
      background: linear-gradient(135deg, #0b0b0f 0%, #1a1a24 50%, #2d3436 100%);
      color: white;
      position: relative;
      overflow: hidden;
    }

    .benefits-section::before {
      content: '';
      position: absolute;
      top: -50%;
      right: -10%;
      width: 800px;
      height: 800px;
      background: radial-gradient(circle, rgba(163, 230, 53, 0.15) 0%, transparent 70%);
      border-radius: 50%;
      z-index: 0;
      animation: float 8s ease-in-out infinite;
    }

    .benefits-section::after {
      content: '';
      position: absolute;
      bottom: -30%;
      left: 5%;
      width: 600px;
      height: 600px;
      background: radial-gradient(circle, rgba(163, 230, 53, 0.1) 0%, transparent 70%);
      border-radius: 50%;
      z-index: 0;
      animation: float 10s ease-in-out infinite reverse;
    }

    .benefits-section .container {
      position: relative;
      z-index: 1;
    }

    .benefits-section h2 {
      color: white;
      font-size: 3rem;
      margin-bottom: 1rem;
      background: linear-gradient(135deg, var(--brand-primary-bright) 0%, var(--brand-primary) 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
      animation: neon-glow 3s ease-in-out infinite;
    }

    .benefits-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
      gap: 2rem;
      margin-top: 3rem;
    }

    .benefit-item {
      background: linear-gradient(135deg, rgba(163, 230, 53, 0.12) 0%, rgba(163, 230, 53, 0.05) 100%);
      border: 2px solid rgba(163, 230, 53, 0.4);
      border-radius: 16px;
      padding: 2.5rem;
      transition: all 0.4s cubic-bezier(0.34, 1.56, 0.64, 1);
      position: relative;
      overflow: hidden;
      animation: fadeInUp 0.8s ease-out both;
    }

    .benefit-item:nth-child(1) { animation-delay: 0.1s; }
    .benefit-item:nth-child(2) { animation-delay: 0.2s; }
    .benefit-item:nth-child(3) { animation-delay: 0.3s; }
    .benefit-item:nth-child(4) { animation-delay: 0.4s; }
    .benefit-item:nth-child(5) { animation-delay: 0.5s; }
    .benefit-item:nth-child(6) { animation-delay: 0.6s; }

    .benefit-item::before {
      content: '';
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      height: 3px;
      background: linear-gradient(90deg, var(--brand-primary) 0%, var(--brand-primary-bright) 50%, transparent 100%);
      opacity: 0;
      transition: opacity 0.3s;
    }

    .benefit-item:hover::before {
      opacity: 1;
    }

    .benefit-item:hover {
      background: linear-gradient(135deg, rgba(163, 230, 53, 0.25) 0%, rgba(163, 230, 53, 0.1) 100%);
      border-color: var(--brand-primary);
      transform: translateY(-12px) scale(1.05);
      box-shadow: 0 25px 60px rgba(163, 230, 53, 0.4), inset 0 1px 1px rgba(163, 230, 53, 0.2);
    }

    .benefit-icon {
      font-size: 4rem;
      margin-bottom: 1.5rem;
      display: inline-block;
      animation: float 3s ease-in-out infinite;
      transition: all 0.3s;
      filter: drop-shadow(0 8px 20px rgba(163, 230, 53, 0.3));
    }

    .benefit-item:hover .benefit-icon {
      animation: rotate-icon 0.6s ease-in-out;
      filter: drop-shadow(0 12px 30px rgba(163, 230, 53, 0.5));
      transform: scale(1.4);
    }

    .benefit-item h3 {
      font-size: 1.6rem;
      margin-bottom: 1rem;
      color: var(--brand-primary-bright);
      font-weight: 800;
      letter-spacing: -0.01em;
    }

    .benefit-item p {
      color: rgba(255, 255, 255, 0.9);
      line-height: 1.8;
      font-size: 1.05rem;
    }

    /* Pricing Section */
    .pricing-section {
      background: linear-gradient(135deg, var(--brand-dark) 0%, #1a2e05 50%, #0f1f00 100%);
      color: white;
      position: relative;
      overflow: hidden;
    }

    .pricing-section::before {
      content: '';
      position: absolute;
      top: -50%;
      right: -10%;
      width: 700px;
      height: 700px;
      background: radial-gradient(circle, rgba(163, 230, 53, 0.12) 0%, transparent 70%);
      border-radius: 50%;
      z-index: 0;
      animation: float 7s ease-in-out infinite;
    }

    .pricing-section .container {
      position: relative;
      z-index: 1;
    }

    .pricing-section h2 {
      color: white;
      margin-bottom: 1rem;
      background: linear-gradient(135deg, var(--brand-primary-bright) 0%, var(--brand-primary) 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
    }

    .currency-selector {
      text-align: center;
      margin-bottom: 3rem;
    }

    .currency-selector label {
      color: rgba(255, 255, 255, 0.9);
      font-weight: 600;
      margin-right: 1.5rem;
    }

    .currency-selector select {
      padding: 0.85rem 1.8rem;
      border-radius: 10px;
      border: 2px solid var(--brand-primary);
      background: rgba(163, 230, 53, 0.15);
      color: white;
      font-size: 1rem;
      font-weight: 600;
      cursor: pointer;
      transition: all 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
      box-shadow: 0 8px 24px rgba(163, 230, 53, 0.2);
    }

    .currency-selector select:hover {
      background: rgba(163, 230, 53, 0.25);
      box-shadow: 0 12px 36px rgba(163, 230, 53, 0.3);
      transform: translateY(-2px);
    }

    .pricing-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
      gap: 2.5rem;
      margin-bottom: 3rem;
    }

    .price-card {
      background: linear-gradient(135deg, rgba(163, 230, 53, 0.08) 0%, rgba(163, 230, 53, 0.02) 100%);
      border: 2px solid rgba(163, 230, 53, 0.4);
      border-radius: 16px;
      padding: 2.5rem;
      backdrop-filter: blur(10px);
      transition: all 0.4s cubic-bezier(0.34, 1.56, 0.64, 1);
      position: relative;
      overflow: hidden;
      animation: fadeInUp 0.8s ease-out both;
    }

    .price-card:nth-child(1) { animation-delay: 0.1s; }
    .price-card:nth-child(2) { animation-delay: 0.2s; }
    .price-card:nth-child(3) { animation-delay: 0.3s; }

    .price-card::before {
      content: '';
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      height: 3px;
      background: linear-gradient(90deg, transparent 0%, var(--brand-primary) 50%, transparent 100%);
      opacity: 0;
      transition: opacity 0.3s;
    }

    .price-card:hover::before {
      opacity: 1;
    }

    .price-card.featured {
      border: 2px solid var(--brand-primary);
      transform: scale(1.05);
      background: linear-gradient(135deg, rgba(163, 230, 53, 0.15) 0%, rgba(163, 230, 53, 0.05) 100%);
    }

    .price-card:hover {
      background: linear-gradient(135deg, rgba(163, 230, 53, 0.2) 0%, rgba(163, 230, 53, 0.08) 100%);
      border-color: var(--brand-primary);
      transform: translateY(-12px) rotateX(5deg);
      box-shadow: 0 35px 70px rgba(163, 230, 53, 0.35);
    }

    .price-card h3 {
      font-size: 2rem;
      margin-bottom: 0.5rem;
      color: var(--brand-primary-bright);
      font-weight: 900;
    }

    .badge {
      background: var(--brand-primary);
      color: var(--brand-dark);
      padding: 0.3rem 0.8rem;
      border-radius: 20px;
      font-size: 0.75rem;
      font-weight: 800;
      margin-left: 0.5rem;
    }

    .price-card .audience {
      color: rgba(255, 255, 255, 0.8);
      font-size: 0.95rem;
      margin-bottom: 1.5rem;
      font-weight: 500;
    }

    .price-card .price-block {
      margin-bottom: 2rem;
      padding: 1.8rem;
      background: rgba(163, 230, 53, 0.12);
      border-radius: 12px;
      border-left: 4px solid var(--brand-primary);
    }

    .price-card .annual {
      font-size: 1.8rem;
      font-weight: 900;
      color: var(--brand-primary-bright);
      margin-bottom: 0.5rem;
      letter-spacing: -0.01em;
    }

    .price-card .per-player {
      font-size: 1rem;
      color: rgba(255, 255, 255, 0.85);
      margin-bottom: 0.5rem;
      font-weight: 500;
    }

    .price-card .example {
      font-size: 0.9rem;
      color: rgba(255, 255, 255, 0.7);
      font-style: italic;
      margin-top: 1rem;
      padding-top: 1rem;
      border-top: 1px solid rgba(163, 230, 53, 0.3);
    }

    .price-card ul {
      list-style: none;
      margin-bottom: 2rem;
    }

    .price-card li {
      color: rgba(255, 255, 255, 0.85);
      margin-bottom: 1rem;
      padding-left: 1.5rem;
      position: relative;
      line-height: 1.6;
      font-weight: 500;
    }

    .price-card li::before {
      content: '✓';
      position: absolute;
      left: 0;
      color: var(--brand-primary);
      font-weight: 900;
      font-size: 1.2rem;
    }

    /* FAQ Section */
    .faq-section {
      background: linear-gradient(135deg, #f8fafc 0%, #ffffff 100%);
    }

    .faq-section h2 {
      background: linear-gradient(135deg, var(--brand-dark) 0%, var(--brand-primary-dark) 100%);
      -webkit-background-clip: text;
