  <script>
    // Exchange rates
    const exchangeRates = {
      USD: 1,
      EUR: 0.92,
      COP: 4180,
      MXN: 17.5,
    };

    // Price update function
    async function updatePrices() {
      const currency = document.getElementById('currency-select').value;
      const rate = exchangeRates[currency];

      const prices = {
        school: { annual: 99, player: 1.50 },
        academy: { annual: 199, player: 1.25 },
        club: { annual: 399, player: 1.00 },
      };

      const symbol = { USD: '$', EUR: '€', COP: '$', MXN: '$' }[currency];

      // Update school
      document.getElementById('price-school-first').textContent = `Primer año GRATIS`;
      document.getElementById('price-school-player').textContent = `${symbol}${(prices.school.player * rate).toFixed(2)}`;

      // Update academy
      document.getElementById('price-academy-annual').textContent = `${symbol}${(prices.academy.annual * rate).toFixed(0)}/año`;
      document.getElementById('price-academy-player').textContent = `${symbol}${(prices.academy.player * rate).toFixed(2)}`;

      // Update club
      document.getElementById('price-club-annual').textContent = `${symbol}${(prices.club.annual * rate).toFixed(0)}/año`;
      document.getElementById('price-club-player').textContent = `${symbol}${(prices.club.player * rate).toFixed(2)}`;
    }

    // Currency selector change event
    const currencySelect = document.getElementById('currency-select');
    if (currencySelect) {
      currencySelect.addEventListener('change', updatePrices);
    }

    // Feature cards interactive effect
    document.querySelectorAll('.feature-card').forEach((card, index) => {
      card.addEventListener('mouseenter', () => {
        card.style.zIndex = 10;
      });
      card.addEventListener('mouseleave', () => {
        card.classList.remove('active-feature');
      });
    });

    // FAQ Toggle with smooth animation
    document.querySelectorAll('.faq-question').forEach(question => {
      question.addEventListener('click', () => {
        const item = question.closest('.faq-item');
        const answer = item.querySelector('.faq-answer');

        // Close other open FAQs
        document.querySelectorAll('.faq-item.active').forEach(openItem => {
          if (openItem !== item) {
            openItem.classList.remove('active');
          }
        });

        item.classList.toggle('active');
      });
    });

    // Mouse parallax effect for hero section
    const hero = document.querySelector('.hero');
    if (hero) {
      document.addEventListener('mousemove', (e) => {
        const moveX = (e.clientX / window.innerWidth) * 20;
        const moveY = (e.clientY / window.innerHeight) * 20;
        hero.style.backgroundPosition = `${moveX}% ${moveY}%`;
      });
    }

    // Intersection Observer for animations on scroll
    const observerOptions = {
      threshold: 0.1,
      rootMargin: '0px 0px -50px 0px',
    };

    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          entry.target.style.opacity = '1';
          entry.target.style.transform = 'translateY(0)';
          entry.target.style.animation = 'fadeInUp 0.8s ease-out forwards';
        }
      });
    }, observerOptions);

    // Smooth scroll
    document.querySelectorAll('a[href^="#"]').forEach(anchor => {
      anchor.addEventListener('click', (e) => {
        e.preventDefault();
        const target = document.querySelector(anchor.getAttribute('href'));
        target?.scrollIntoView({ behavior: 'smooth' });
      });
    });

    // Initial price update
    updatePrices();
  </script>
