---
import AuthBrandPage from '../components/auth/AuthBrandPage.astro';
import PasswordRecoveryIsland from '../components/auth/PasswordRecoveryIsland';
import { resolveLocale, t } from '@velocesport/i18n';

const locale = resolveLocale(Astro.cookies, Astro.request.headers.get('accept-language'));
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const token = Astro.url.searchParams.get('token') ?? undefined;

// El token va en la URL: que no viaje en el Referer a ningún otro sitio ni se cachee.
Astro.response.headers.set('Referrer-Policy', 'no-referrer');
Astro.response.headers.set('Cache-Control', 'no-store');
---

<AuthBrandPage locale={locale} title={t('auth.recovery.metaTitle', locale)}>
  <PasswordRecoveryIsland
    client:idle
    initialLocale={locale}
    apiUrl={`${base}/api/auth`}
    mode="reset"
    token={token}
  />
</AuthBrandPage>
