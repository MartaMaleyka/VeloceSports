---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ChangePasswordRequiredPage from '../../components/auth/ChangePasswordRequiredPage';
import { getSession } from '../../lib/session';
import { t } from '@velocesport/i18n';

const session = getSession(Astro.cookies);
if (!session) {
  return Astro.redirect('/login');
}

const locale = Astro.locals.locale;
---

<BaseLayout
  locale={locale}
  title={`${t('auth.forcedChange.title', locale)} — ${t('common.appName', locale)}`}
>
  <ChangePasswordRequiredPage client:load initialLocale={locale} />
</BaseLayout>
