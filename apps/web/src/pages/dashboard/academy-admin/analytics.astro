---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import DashboardShell from '../../../components/layout/DashboardShell';
import { getSession } from '../../../lib/session';
import { redirectUnlessRole } from '../../../lib/page-access';
import { getRoleLabel } from '../../../lib/navigation';
import { t } from '@velocesport/i18n';

const session = getSession(Astro.cookies);
const accessDenied = redirectUnlessRole(session, 'academy_admin');
if (accessDenied) return Astro.redirect(accessDenied);

const locale = Astro.locals.locale;
const roleLabel = getRoleLabel(session.role, locale);
---

<BaseLayout
  locale={locale}
  title={`${roleLabel} — ${t('common.appName', locale)}`}
  description={t('meta.appDescription', locale)}
>
  <DashboardShell
    client:load
    initialLocale={locale}
    role={session.role}
    userId={session.userId}
    roles={session.roles}
    activeNavId="analytics"
    contentKey="academyAdmin"
    pageId="analytics"
    pageTitle={t('dashboard.academyAdmin.analytics.title', locale)}
    pageDescription={t('dashboard.academyAdmin.analytics.description', locale)}
    headerSectionAccent="brand"
  />
</BaseLayout>
