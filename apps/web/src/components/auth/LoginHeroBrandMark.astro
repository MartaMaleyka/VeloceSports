---
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const logoSrc = `${base}brand/logo-dark.png`;
---

<div class="ds-brand-hero-logo">
  <div class="ds-brand-hero-logo__content">
    <img
      src={logoSrc}
      alt=""
      width="640"
      height="640"
      class="ds-brand-hero-logo__img ds-brand-hero-logo__img--dark"
      decoding="async"
      fetchpriority="high"
    />
  </div>
</div>
