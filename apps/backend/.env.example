# Server
NODE_ENV=development
PORT=3000

# MySQL — instancia nativa local (Windows, servicio en localhost:3306)
DB_HOST=localhost
DB_PORT=3306
DB_USER=academia_app
DB_PASSWORD=
DB_NAME=academia_futbol

# JWT — reemplazar en producción
JWT_ACCESS_SECRET=dev-access-secret-change-in-production-min-32-chars
JWT_REFRESH_SECRET=dev-refresh-secret-change-in-production-min-32-chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Cierre de sesión por inactividad (duración estilo JWT: 60m, 1h)
SESSION_INACTIVITY_TIMEOUT=60m

# CORS (orígenes separados por coma)
CORS_ORIGINS=http://localhost:4321,http://localhost:3000

# Session (legacy — express-session eliminado; opcional si queda en .env local)
# SESSION_SECRET=dev-session-secret-change-in-production

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=2000
AUTH_LOGIN_RATE_LIMIT_WINDOW_MS=900000
AUTH_LOGIN_RATE_LIMIT_MAX=5

# Captura / corrección post-partido
GAME_ACTION_IMMEDIATE_UNDO_WINDOW_SECONDS=10
MATCH_CORRECTION_WINDOW_DAYS=7

# MinIO (fotos de jugadores) — local Docker Compose
MINIO_ENDPOINT=127.0.0.1
MINIO_PORT=9100
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin_change_me
MINIO_BUCKET=squadveloce-players
MINIO_USE_SSL=false
# Si el backend corre en Docker y MinIO se publica en el host:
# MINIO_ENDPOINT=host.docker.internal
# MINIO_PORT=9100
# MINIO_PUBLIC_ENDPOINT=127.0.0.1
# MINIO_PUBLIC_PORT=9100
# (el SDK firma con region us-east-1; el public endpoint no necesita ser alcanzable desde el contenedor)

# Agente de interpretación de estadísticas (IA local vía Ollama, sin datos a terceros).
# Prerequisito de infraestructura: instalar Ollama y descargar el modelo antes de habilitar
# (`ollama serve` + `ollama pull llama3.2:3b`). Con OLLAMA_ENABLED=false el feature funciona
# igual, sirviendo siempre el análisis de respaldo determinístico.
OLLAMA_ENABLED=true
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:3b
OLLAMA_TIMEOUT_MS=45000
# El endpoint se consulta por polling mientras se genera; una sola generación ya
# implica varias peticiones, así que el límite cubre eso, no "N generaciones".
PLAYER_INSIGHT_RATE_LIMIT_WINDOW_MS=900000
PLAYER_INSIGHT_RATE_LIMIT_MAX=60
